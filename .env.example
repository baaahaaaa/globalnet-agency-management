# Copy and adapt locally. Do not commit .env.
# Generate a strong, random JWT secret (32+ bytes).
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_BYTES
DB_URL=jdbc:mysql://localhost:3306/globalnet
DB_USERNAME=root
DB_PASSWORD=
JPA_DDL_AUTO=update
CORS_ORIGIN=http://localhost:4200
# Only set on first start to create an admin user
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
